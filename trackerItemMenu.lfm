<?xml version="1.0" encoding="UTF-8"?>

<popupForm name="frmTrackerItemMenu"
           width="284"
           height="198"
           drawContainer="false"
           cancelable="true"
           resizable="false"
           movable="false"
           placement="mouse">

    <script>
        local trackerMenu = require("trackerMenu.lua");
    </script>

    <rectangle name="menuCard" align="none" left="2" top="2" width="280" height="194"
               color="#181C21" strokeColor="#3B4654" strokeSize="1" xradius="5" yradius="5" hitTest="false">
    <button name="btnRolar" align="none" left="2" width="276" height="30" fontSize="13" text="Rolar iniciativa">
        <event name="onClick"><![CDATA[
            trackerMenu.rollInitiative(self, sheet);
        ]]></event>
    </button>

    <button name="btnGrupo" align="none" left="2" width="276" height="30" fontSize="13" text="Grupo">
        <event name="onClick"><![CDATA[
            trackerMenu.openGroupMenu(self, sheet);
        ]]></event>
    </button>

    <button name="btnCor" align="none" left="2" width="276" height="30" fontSize="13" text="Cor">
        <event name="onClick"><![CDATA[
            trackerMenu.openItemColorMenu(self, sheet);
        ]]></event>
    </button>

    <button name="btnVisibilidade" align="none" left="2" width="276" height="30" fontSize="13" text="Visibilidade" visible="false">
        <event name="onClick"><![CDATA[
            trackerMenu.changeVisibility(self, sheet);
        ]]></event>
    </button>

    <button name="btnFixar" align="none" left="2" width="276" height="30" fontSize="13" text="Fixar posição" visible="false">
        <event name="onClick"><![CDATA[
            trackerMenu.togglePin(self, sheet);
        ]]></event>
    </button>

    <button name="btnTemporario" align="none" left="2" width="276" height="30" fontSize="13" text="Temporário">
        <event name="onClick"><![CDATA[
            trackerMenu.openTemporaryMenu(self, sheet);
        ]]></event>
    </button>
    </rectangle>
</popupForm>
